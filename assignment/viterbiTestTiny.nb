Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"hmm4", " ", "has", " ", "3", " ", 
     RowBox[{"states", ".", " ", "Its"}], " ", "transition", " ", 
     "probabilities", " ", "prefer", " ", "to", " ", "cycle", " ", "from", 
     " ", "\[IndentingNewLine]", "states", " ", "1", " ", "to", " ", "2"}], 
    ",", " ", 
    RowBox[{"2", " ", "to", " ", "3"}], ",", " ", 
    RowBox[{"and", " ", "3", " ", "to", " ", "1"}], ",", "  ", 
    RowBox[{
    "and", " ", "its", " ", "initial", " ", "state", " ", "distribution", " ",
      "forces", " ", "it", " ", "to", " ", "always", " ", "start", " ", "in", 
     " ", "state", " ", "1.", " ", "Observations", " ", "1"}], ",", " ", "2", 
    ",", " ", 
    RowBox[{"and", " ", "3"}], ",", " ", 
    RowBox[{
    "can", " ", "only", " ", "be", " ", "emitted", " ", "by", " ", "states", 
     " ", "1"}], ",", " ", "2", ",", " ", 
    RowBox[{"and", " ", "3"}], ",", " ", 
    RowBox[{
     RowBox[{"respectively", ".", " ", "Obervation"}], " ", "4", " ", "is", 
     " ", "equally", " ", "likely", " ", "from", " ", "all", " ", 
     RowBox[{"states", ".", " ", "Therefore"}]}], ",", " ", 
    RowBox[{
    "the", " ", "decode", " ", "will", " ", "tend", " ", "to", " ", "cycle", 
     " ", "on", " ", "observation", " ", "4"}], ",", " ", 
    RowBox[{
    "but", " ", "will", " ", "be", " ", "pulled", " ", "to", " ", "the", " ", 
     "corresponding", " ", "state", " ", "on", " ", "observations", " ", 
     "1"}], ",", " ", "2", ",", " ", 
    RowBox[{"and", " ", "3."}]}], "\[IndentingNewLine]", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"matrix5", "=", 
   RowBox[{"myRound", "[", 
    RowBox[{
     RowBox[{"buildMatrix", "[", 
      RowBox[{
       RowBox[{"{", 
