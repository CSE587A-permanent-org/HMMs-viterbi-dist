Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "hmm1", " ", "startts", " ", "in", " ", "state", " ", "1", " ", "with", 
     " ", "probability", " ", 
     RowBox[{"1.0", ".", " ", "But"}], " ", "observation", " ", "3", " ", 
     "has", " ", "zero", " ", "probability", " ", "of", " ", "being", " ", 
     "emitted", " ", "from", " ", "state", " ", "1.", " ", "Therefore"}], ",",
     " ", 
    RowBox[{
    "we", " ", "are", " ", "asking", " ", "the", " ", "algorithm", " ", "to", 
     " ", "decode", " ", "an", " ", "impossible", " ", "observation", " ", 
     "sequence"}], ",", " ", 
    RowBox[{"and", " ", "the", " ", "result", " ", "is", " ", 
     RowBox[{"indeterminant", ".", " ", "The"}], " ", "attempt", " ", "to", 
     " ", "normalize", " ", "a", " ", "Viterbi", " ", "vector", " ", "of", 
     " ", "all", " ", "zeros", " ", "causes", " ", "the", " ", 
     "indeterminant", " ", 
     RowBox[{"result", "."}]}]}], "*)"}], "\[IndentingNewLine]", 
