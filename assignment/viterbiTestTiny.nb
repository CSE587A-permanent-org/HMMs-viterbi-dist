Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"In", " ", "hmm2"}], ",", " ", 
    RowBox[{
    "observations", " ", "1", " ", "and", " ", "4", " ", "can", " ", "only", 
     " ", "be", " ", "output", " ", "from", " ", "states", " ", "1", " ", 
     "and", " ", "2"}], ",", " ", "respectively", ",", " ", 
    RowBox[{
    "but", " ", "observations", " ", "2", " ", "and", " ", "3", " ", "are", 
     " ", "equally", " ", "likely", " ", "to", " ", "come", " ", "from", " ", 
     "either", " ", 
     RowBox[{"state", ".", " ", "Both"}], " ", "states", " ", "prefer", " ", 
     "to", " ", "transition", " ", "into", " ", "the", " ", "other"}], ",", 
    " ", 
    RowBox[{
    "so", " ", "when", " ", "the", " ", "observations", "\[IndentingNewLine]",
      "are", " ", "equally", " ", "likely", " ", "under", " ", "either", " ", 
     "state"}], ",", " ", 
    RowBox[{"they", " ", "will", " ", "tend", " ", "to", " ", 
