Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"hmm2", " ", "likes", " ", "to", " ", "switch", " ", "states"}], 
    ",", " ", 
    RowBox[{
    "all", " ", "other", " ", "things", " ", "being", " ", "equal", " ", 
     "but", " ", "the", " ", "decoding", " ", "has", " ", "to", " ", "begin", 
     " ", "in", " ", "state", " ", "1", " ", "and", " ", "end", " ", "in", 
     " ", "state", " ", "2"}], ",", " ", 
    RowBox[{
    "because", " ", "of", " ", "the", " ", "observations", " ", "of", " ", 
     "1", " ", "and", " ", "4", " ", 
     RowBox[{"respectively", ".", " ", "If"}], " ", "the", " ", "number", " ",
      "of", " ", "states", " ", "in", " ", "between", " ", "in", " ", "is", 
     " ", "odd"}], ",", " ", 
    RowBox[{
    "the", " ", "number", " ", "of", " ", "transition", " ", "in", " ", 
     "between", " ", "is", " ", "even"}], ",", " ", 
    RowBox[{"so", " ", "it", " ", 
     RowBox[{"can", "'"}], "t", " ", "alternate", " ", "and", " ", "still", 
     " ", "start", " ", "in", " ", "state", " ", "1", " ", "and", " ", "end", 
     " ", "in", " ", "state", " ", "2.", " ", "As", " ", "a", " ", "result"}],
     ",", " ", 
    RowBox[{
    "the", " ", "same", " ", "state", " ", "must", " ", "occur", " ", "twice",
      " ", "in", " ", "a", " ", 
     RowBox[{"row", ".", " ", "In"}], " ", "this", " ", "case"}], ",", " ", 
    RowBox[{
    "it", " ", "is", " ", "equally", " ", "likely", " ", "to", " ", "happen", 
     " ", "at", " ", "any", " ", "point", " ", "in", " ", "the", " ", 
     "sequence"}], ",", " ", 
    RowBox[{
    "so", " ", "the", " ", "behavior", " ", "will", " ", "depend", " ", "on", 
     " ", "the", " ", 
     RowBox[{"implementation", "."}]}]}], "\[IndentingNewLine]", " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"viterbiDecode", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"1", ",", "3", ",", "2", ",", " ", "3", ",", " ", "4"}], "}"}], 
    ",", " ", "hmm2"}], "]"}]}]], "VerificationTest",
 CellChangeTimes->{{3.7757653272216263`*^9, 3.775765576667459*^9}, {
  3.775765633548715*^9, 3.77576564974267*^9}},
 CellLabel->"In[65]:=",
 CellID->1287658232,ExpressionUUID->"391a05ea-bc42-4185-8e5f-fe4ce4ff5a91"],

