Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"hmm3", " ", "has", " ", "3", " ", 
     RowBox[{"states", ".", " ", "Its"}], " ", "transition", " ", 
     "probabilities", " ", "force", " ", "it", " ", "to", " ", "always", " ", 
     "cycle", " ", "from", " ", "\[IndentingNewLine]", "states", " ", "1", 
     " ", "to", " ", "2"}], ",", " ", 
    RowBox[{"2", " ", "to", " ", "3"}], ",", " ", 
    RowBox[{"and", " ", "3", " ", "to", " ", "1"}], ",", "  ", 
    RowBox[{
    "and", " ", "its", " ", "initial", " ", "state", " ", "distribution", " ",
      "forces", " ", "it", " ", "to", " ", "always", " ", "start", " ", "in", 
     " ", "state", " ", "1.", " ", "The", " ", "emission", " ", 
     "probabilities", " ", "of", " ", "each", " ", "state", " ", "are", " ", 
     "different"}], ",", " ", 
    RowBox[{"but", " ", "that", " ", 
     RowBox[{"shouldn", "'"}], "t", " ", "affect", " ", "the", " ", 
     "traceback", " ", "because", " ", "the", " ", "transcrissions", " ", 
     "force", " ", "it", " ", "to", " ", "cycle", " ", "regardless", " ", 
     "of", " ", "the", " ", 
     RowBox[{"input", "."}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{"matrix4", "=", 
   RowBox[{"myRound", "[", 
    RowBox[{
     RowBox[{"buildMatrix", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "1", ",", "3", ",", "2", ",", " ", "3", ",", " ", "2", ",", " ", 
         "4"}], "}"}], ",", "hmm3"}], "]"}], ",", " ", "3"}], 
    "]"}]}]}]], "VerificationTest",
